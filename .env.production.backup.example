# Secure RAG remote backup configuration.
#
# Copy the relevant values into the real production environment.
# Never commit real credentials.

# S3-compatible remote backup destination.
# Example:
# BACKUP_REMOTE_URI=s3://my-secure-rag-backups/production
BACKUP_REMOTE_URI=s3://replace-with-your-backup-bucket/secure-rag/production

# Retain remote backups newer than this many days.
BACKUP_RETENTION_DAYS=30

# Optional for S3-compatible providers other than AWS S3.
# Leave empty when using standard AWS S3.
#
# Example:
# AWS_ENDPOINT_URL=https://s3.example-provider.com
AWS_ENDPOINT_URL=

# Credentials should be supplied through the AWS CLI credential chain.
#
# Examples include:
#   AWS_PROFILE=production-backups
#   AWS_ACCESS_KEY_ID=...
#   AWS_SECRET_ACCESS_KEY=...
#
# Prefer a role, workload identity, or external credential mechanism
# over static credentials wherever the deployment environment supports it.